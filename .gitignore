# Share the standalone position toolkit, weighted UR3e collector and Franka code.
# Existing simulation campaigns, paper builds, videos and unrelated CAD stay local.
/*
!/.gitignore
!/franka_eit_vmc/
!/eit_position_toolkit/
!/ur3e_weight_position_data_collection/
/ur3e_weight_position_data_collection/*
!/ur3e_weight_position_data_collection/ur3e_code/
/eit_palm_robot_mount/

# Generated files and raw measurements inside the included code directories.
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/build/
**/install/
**/log/
**/trial_logs/
**/sessions/
**/runs/
**/contact_position_data/
**/contact_position_runs/
**/signal_diagnostics/
# Local signal snapshots and measured UR3e calibration/fixture poses.
**/eit_signal_*.json
/ur3e_weight_position_data_collection/ur3e_code/pad_calibration.json
/ur3e_weight_position_data_collection/ur3e_code/mount_pose.json
*.pyc
*.pyo
*.bag
*.db3
*.mcap
*.csv
*.jsonl
*.npy
*.npz
*.joblib
*.png
*.pdf

# Portable distribution archives are local copies of the source folders.
*.zip
*.tar.gz
*.tgz
*.tar.xz

# Explicitly shared model exports; raw session checkpoints remain ignored.
!/eit_position_toolkit/models/
!/eit_position_toolkit/models/*.npz
!/eit_position_toolkit/models/*.joblib
!/franka_eit_vmc/models/*.npz
!/franka_eit_vmc/models/*.joblib

# Keep the assembly figures linked from the weighted collector's README.
!/ur3e_weight_position_data_collection/ur3e_code/figures/*.png
!/ur3e_weight_position_data_collection/ur3e_code/figures/*.pdf
